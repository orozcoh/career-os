---
import type { ResumeData, SectionId } from "@career/core";
import type { Locale } from "@career/core";
import { t, formatDateRange, formatYearRange, visibleSections } from "@career/core";
import type { LocaleFile } from "@career/core";

interface Props {
  resume: ResumeData;
  locale: LocaleFile;
  lang: Locale;
}

const { resume, locale, lang } = Astro.props;
const { profile } = resume;
const sections = visibleSections(resume);

const SIDEBAR_SECTIONS = new Set<SectionId>(["skills", "education", "languages"]);
const mainSections = sections.filter((s) => !SIDEBAR_SECTIONS.has(s));
const sidebarSections = sections.filter((s) => SIDEBAR_SECTIONS.has(s));
const sectionGroups = [
  { className: "resume-main", items: mainSections },
  { className: "resume-sidebar", items: sidebarSections },
].filter((group) => group.items.length > 0);

/** Display a URL without its protocol: "https://github.com/x" → "github.com/x" */
const displayUrl = (url: string) => url.replace(/^https?:\/\//, "").replace(/\/$/, "");

const contacts = [
  { label: profile.location, href: null },
  { label: profile.email, href: `mailto:${profile.email}` },
  { label: displayUrl(profile.linkedin), href: profile.linkedin },
  { label: displayUrl(profile.github), href: profile.github },
  { label: displayUrl(profile.website), href: profile.website },
  { label: displayUrl(profile.cv), href: profile.cv },
];

const contactGroups = [
  [contacts[0]],
  [contacts[1], contacts[2], contacts[3]],
  [contacts[4], contacts[5]],
];

const sectionIds: Record<SectionId, string> = {
  summary: "section-summary",
  experience: "section-experience",
  projects: "section-projects",
  skills: "section-skills",
  education: "section-education",
  languages: "section-languages",
};
---

<article class="resume mx-auto max-w-[46rem] px-6 py-12">
  <header class="resume-header">
    <div class="resume-identity">
      <h1 class="text-3xl font-semibold tracking-tight">{profile.name}</h1>
      <p class="mt-1 text-lg text-muted">{t(resume.title, lang)}</p>
    </div>
    <div class="resume-contact mt-3 space-y-1 text-sm leading-6 text-muted">
      {
        contactGroups.map((group) => (
          <p>
            {group.map((c, i) => (
              <>
                {i > 0 && " · "}
                {c.href ? (
                  <a href={c.href} class="text-accent hover:text-accent-hover">
                    {c.label}
                  </a>
                ) : (
                  <span>{c.label}</span>
                )}
              </>
            ))}
          </p>
        ))
      }
    </div>
  </header>

  <div class="resume-body">
    {
      sectionGroups.map((group) => (
        <div class={group.className}>
          {group.items.map((section) => (
            <section aria-labelledby={sectionIds[section]} class="resume-section mt-10">
              <h2
                id={sectionIds[section]}
                class="border-b border-line pb-2 text-xs font-semibold uppercase tracking-[0.15em] text-muted"
              >
                {locale.sections[section]}
              </h2>

              {section === "summary" && <p class="resume-copy mt-4 leading-7">{t(resume.summary, lang)}</p>}

              {section === "experience" && (
                <div class="resume-entries mt-4 space-y-8">
                  {resume.experience.map((role) => (
                    <div class="avoid-break">
                      <h3 class="text-base font-medium">
                        {[t(role.title, lang), t(role.company, lang)].filter(Boolean).join(" — ")}
                      </h3>
                      <p class="mt-0.5 text-sm text-muted">
                        {[
                          formatDateRange(role.start, role.end, locale),
                          role.location,
                          locale.employment_types[role.employment_type],
                        ]
                          .filter(Boolean)
                          .join(" · ")}
                      </p>
                      <ul class="resume-bullets mt-2 list-disc space-y-1 pl-5 leading-7">
                        {role.bullets.map((b) => (
                          <li>{t(b.text, lang)}</li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
              )}

              {section === "projects" && (
                <div class="resume-entries mt-4 space-y-8">
                  {resume.projects.map((project) => (
                    <div class="avoid-break">
                      <h3 class="text-base font-medium">{project.name}</h3>
                      <p class="mt-0.5 text-sm italic text-muted">{t(project.tagline, lang)}</p>
                      {resume.template.project_layout !== "compact" && (
                        <p class="resume-copy mt-2 leading-7">{t(project.description, lang)}</p>
                      )}
                      {project.highlights.length > 0 && (
                        <ul class="resume-bullets mt-2 list-disc space-y-1 pl-5 leading-7">
                          {project.highlights.map((h) => (
                            <li>{t(h.text, lang)}</li>
                          ))}
                        </ul>
                      )}
                      {project.technologies.length > 0 &&
                        (resume.template.project_layout === "compact" ? (
                          <p class="mt-2 text-sm text-muted">{project.technologies.join(" · ")}</p>
                        ) : (
                          <p class="mt-2 text-sm text-muted">
                            <span class="font-medium text-ink">{locale.resume.technologies}:</span>{" "}
                            {project.technologies.join(", ")}
                          </p>
                        ))}
                      {project.links.length > 0 && (
                        <p class="mt-1 text-sm">
                          {project.links.map((link, i) => (
                            <>
                              {i > 0 && <span class="text-faint">{" · "}</span>}
                              <a href={link.url} class="text-accent hover:text-accent-hover">
                                {t(link.label, lang)}
                              </a>
                            </>
                          ))}
                        </p>
                      )}
                    </div>
                  ))}
                </div>
              )}

              {section === "skills" && (
                <ul class="resume-skills mt-4 space-y-1.5 leading-7">
                  {resume.skills.map((category) => (
                    <li class="avoid-break">
                      <span class="skill-category font-medium">{t(category.category, lang)}:</span>{" "}
                      <span class="skill-items text-muted">{category.items.map((i) => t(i.name, lang)).join(", ")}</span>
                    </li>
                  ))}
                </ul>
              )}

              {section === "education" && (
                <div class="resume-entries mt-4 space-y-6">
                  {resume.education.map((edu) => (
                    <div class="avoid-break">
                      <h3 class="text-base font-medium">
                        {t(edu.degree, lang)} {t(edu.field, lang)} — {edu.institution}
                      </h3>
                      <p class="mt-0.5 text-sm text-muted">
                        {formatYearRange(edu.start, edu.end, locale)} · {edu.location}
                      </p>
                      {edu.highlights.length > 0 && (
                        <ul class="resume-bullets mt-2 list-disc space-y-1 pl-5 leading-7">
                          {edu.highlights.map((h) => (
                            <li>{t(h, lang)}</li>
                          ))}
                        </ul>
                      )}
                    </div>
                  ))}
                </div>
              )}

              {section === "languages" && (
                <ul class="resume-bullets mt-4 list-disc space-y-1 pl-5 leading-7">
                  {resume.languages.map((l) => (
                    <li>
                      {t(l.name, lang)} — <span class="text-muted">{locale.proficiency_levels[l.proficiency]}</span>
                    </li>
                  ))}
                </ul>
              )}
            </section>
          ))}
        </div>
      ))
    }
  </div>
</article>
