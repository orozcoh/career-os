---
import Plain from "../layouts/Plain.astro";
import "../styles/analytics.css";
---

<Plain title="Resume Analytics">
  <main class="wrap">
    <header class="topbar">
      <div>
        <h1>Resume Analytics</h1>
        <p class="muted">cv.orozcoh.com — private dashboard</p>
      </div>
      <div class="actions">
        <span id="status" class="status"></span>
        <button id="refresh" type="button">Refresh</button>
      </div>
    </header>

    <section id="gate" class="gate">
      <form id="key-form">
        <label for="key-input">Analytics key</label>
        <div class="row">
          <input id="key-input" type="password" autocomplete="off" spellcheck="false" />
          <button type="submit">Unlock</button>
        </div>
        <p id="key-error" class="error hidden">Invalid key</p>
      </form>
    </section>

    <div id="dash" class="hidden">
      <section class="cards">
        <div class="card">
          <div class="num" id="s-downloads">–</div>
          <div class="label">Downloads</div>
          <div class="sub" id="s-downloads-sub"></div>
        </div>
        <div class="card">
          <div class="num" id="s-views">–</div>
          <div class="label">Resume views</div>
          <div class="sub" id="s-views-sub"></div>
        </div>
        <div class="card">
          <div class="num" id="s-opens">–</div>
          <div class="label">Resume opens</div>
          <div class="sub" id="s-opens-sub"></div>
        </div>
        <div class="card">
          <div class="num" id="s-pageviews">–</div>
          <div class="label">Page views</div>
          <div class="sub" id="s-pageviews-sub"></div>
        </div>
      </section>

      <section>
        <div class="funnel-head">
          <div>
            <h2>Funnel</h2>
            <p class="sub" id="funnel-note">conversion from opens · all time</p>
          </div>
          <div class="seg" id="funnel-window">
            <button type="button" data-window="all" class="active">All time</button>
            <button type="button" data-window="today">Today</button>
            <button type="button" data-window="week">Last 7 days</button>
          </div>
        </div>
        <div class="funnel" id="funnel"></div>
      </section>

      <section class="two-col">
        <div>
          <h2>By resume</h2>
          <table class="table">
            <thead>
              <tr>
                <th>Resume</th>
                <th>Opens</th>
                <th>Views</th>
                <th>Downloads</th>
              </tr>
            </thead>
            <tbody id="t-resumes"></tbody>
          </table>
        </div>
        <div>
          <h2>By language</h2>
          <table class="table">
            <thead>
              <tr>
                <th>Language</th>
                <th>Views</th>
                <th>Downloads</th>
              </tr>
            </thead>
            <tbody id="t-languages"></tbody>
          </table>
        </div>
      </section>

      <section class="two-col">
        <div>
          <h2>Top countries</h2>
          <ol class="rank" id="t-countries"></ol>
        </div>
        <div>
          <h2>Top cities</h2>
          <ol class="rank" id="t-cities"></ol>
        </div>
      </section>

      <section>
        <h2>Recent activity</h2>
        <table class="table">
          <thead>
            <tr>
              <th>When</th>
              <th>Event</th>
              <th>Resume</th>
              <th>Format</th>
              <th>Location</th>
              <th>Version</th>
            </tr>
          </thead>
          <tbody id="t-live"></tbody>
        </table>
      </section>
    </div>
  </main>

<script is:inline>
  const KEY_STORAGE = "cv_analytics_key";
  const $ = (id) => document.getElementById(id.replace(/^#/, ""));

  const statusEl = $("#status");
  const dash = $("#dash");
  const gate = $("#gate");
  const keyInput = $("#key-input");
  const keyError = $("#key-error");

  function setStatus(text) {
    if (statusEl) statusEl.textContent = text;
  }

  async function api(path) {
    const key = sessionStorage.getItem(KEY_STORAGE);
    const res = await fetch(`/api/admin/analytics${path}`, {
      headers: key ? { "X-Analytics-Key": key } : {},
    });
    if (res.status === 401) throw new Error("unauthorized");
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    return res.json();
  }

  function fmt(n) {
    return new Intl.NumberFormat("en-US", { notation: n >= 1000 ? "compact" : "standard" }).format(n);
  }

  function pct(part, whole) {
    if (whole === 0) return "—";
    return `${Math.round((part / whole) * 100)}%`;
  }

  function cell(text, cls = "") {
    const td = document.createElement("td");
    td.textContent = String(text);
    if (cls) td.className = cls;
    return td;
  }

  const FUNNEL_WINDOWS = {
    all: { label: "all time", query: "" },
    today: { label: "today", query: "?window=today" },
    week: { label: "last 7 days", query: "?window=week" },
  };
  let funnelWindow = "all";

  async function loadFunnel(window = funnelWindow) {
    const w = FUNNEL_WINDOWS[window] ?? FUNNEL_WINDOWS.all;
    funnelWindow = window;
    const note = $("#funnel-note");
    if (note) note.textContent = `conversion from opens · ${w.label}`;
    const funnel = await api(`/funnel${w.query}`).catch(() => null);
    renderFunnel(funnel ?? { opens: 0, views: 0, downloads: 0 });
  }

  function renderFunnel(funnel) {
    const funnelEl = $("#funnel");
    if (!funnelEl) return;
    funnelEl.innerHTML = "";
    const opens = Number(funnel.opens ?? 0);
    const steps = [
      { name: "Opens", value: opens },
      { name: "Views", value: Number(funnel.views ?? 0) },
      { name: "Downloads", value: Number(funnel.downloads ?? 0) },
    ];
    const max = Math.max(1, opens);
    for (const step of steps) {
      const row = document.createElement("div");
      row.className = "fstep";
      const name = document.createElement("span");
      name.className = "fname";
      name.textContent = step.name;
      const bar = document.createElement("div");
      bar.className = "fbar";
      const fill = document.createElement("div");
      fill.className = "fill";
      fill.style.width = `${Math.max(2, (step.value / max) * 100)}%`;
      bar.appendChild(fill);
      const count = document.createElement("span");
      count.className = "fcount";
      count.textContent = fmt(step.value);
      const p = document.createElement("span");
      p.className = "fpct";
      p.textContent = step.name === "Opens" ? "100% (baseline)" : `${pct(step.value, opens)} of opens`;
      row.append(name, bar, count, p);
      funnelEl.appendChild(row);
    }
  }

  async function load() {
    setStatus("Loading…");
    try {
      const results = await Promise.all([
        api("/summary"),
        api("/resumes"),
        api("/languages"),
        api("/countries"),
        api("/cities"),
        api("/live"),
      ]);

      const summary = results[0] ?? {};
      const resumes = results[1] ?? [];
      const languages = results[2] ?? [];
      const countries = results[3] ?? [];
      const cities = results[4] ?? [];
      const live = results[5] ?? [];

      const totals = summary.totals ?? {};
      const today = summary.today ?? {};
      const week = summary.week ?? {};
      const d = totals.downloads ?? 0;
      const v = totals.views ?? 0;
      const o = totals.opens ?? 0;
      const pv = totals.pageViews ?? 0;

      setText("#s-downloads", fmt(d));
      setText("#s-downloads-sub", `${fmt(today.downloads ?? 0)} today · ${fmt(week.downloads ?? 0)} week`);
      setText("#s-views", fmt(v));
      setText("#s-views-sub", `${fmt(today.views ?? 0)} today · ${fmt(week.views ?? 0)} week`);
      setText("#s-opens", fmt(o));
      setText("#s-opens-sub", `${fmt(today.opens ?? 0)} today`);
      setText("#s-pageviews", fmt(pv));
      setText("#s-pageviews-sub", `${fmt(today.pageViews ?? 0)} today`);

      await loadFunnel(funnelWindow);

      const resumesBody = $("#t-resumes");
      if (resumesBody) {
        resumesBody.innerHTML = "";
        for (const r of resumes) {
          const tr = document.createElement("tr");
          tr.append(
            cell(String(r.resume)),
            cell(fmt(Number(r.opens ?? 0)), "num"),
            cell(fmt(Number(r.views ?? 0)), "num"),
            cell(fmt(Number(r.downloads ?? 0)), "num"),
          );
          resumesBody.appendChild(tr);
        }
      }

      const languagesBody = $("#t-languages");
      if (languagesBody) {
        languagesBody.innerHTML = "";
        for (const l of languages) {
          const tr = document.createElement("tr");
          tr.append(
            cell(String(l.language)),
            cell(fmt(Number(l.views ?? 0)), "num"),
            cell(fmt(Number(l.downloads ?? 0)), "num"),
          );
          languagesBody.appendChild(tr);
        }
      }

      const countriesEl = $("#t-countries");
      if (countriesEl) {
        countriesEl.innerHTML = "";
        for (const c of countries.slice(0, 10)) {
          const li = document.createElement("li");
          const name = document.createElement("span");
          name.className = "name";
          name.textContent = String(c.name);
          const count = document.createElement("span");
          count.className = "count";
          count.textContent = `${fmt(Number(c.downloads ?? 0))} downloads`;
          li.append(name, count);
          countriesEl.appendChild(li);
        }
      }

      const citiesEl = $("#t-cities");
      if (citiesEl) {
        citiesEl.innerHTML = "";
        for (const c of cities.slice(0, 10)) {
          const li = document.createElement("li");
          const name = document.createElement("span");
          name.className = "name";
          name.textContent = String(c.name);
          const count = document.createElement("span");
          count.className = "count";
          count.textContent = `${fmt(Number(c.downloads ?? 0))} downloads`;
          li.append(name, count);
          citiesEl.appendChild(li);
        }
      }

      const liveBody = $("#t-live");
      if (liveBody) {
        liveBody.innerHTML = "";
        const time = new Intl.RelativeTimeFormat("en", { numeric: "auto" });
        for (const ev of live) {
          const tr = document.createElement("tr");
          const when = new Date(ev.timestamp);
          const ago = time.format(-Math.max(0, Math.round((Date.now() - when.getTime()) / 60000)), "minute");
          tr.className = "live-event";
          tr.append(
            cell(ago),
            cell(ev.event),
            cell(ev.resume || "—"),
            cell(ev.format || "—"),
            cell([ev.city, ev.country].filter(Boolean).join(", ") || "—"),
            cell(ev.version),
          );
          liveBody.appendChild(tr);
        }
      }

      setStatus(`Updated ${new Date().toLocaleTimeString()}`);
      return true;
    } catch (error) {
      if (error instanceof Error && error.message === "unauthorized") {
        if (gate) gate.classList.remove("hidden");
        if (dash) dash.classList.add("hidden");
        setStatus("Key required");
      } else {
        setStatus(`Error: ${error instanceof Error ? error.message : "unknown"}`);
      }
      return false;
    }
  }

  function setText(id, text) {
    const el = $(id);
    if (el) el.textContent = text;
  }

  const keyForm = $("#key-form");
  keyForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const key = keyInput?.value.trim() ?? "";
    if (!key) return;
    sessionStorage.setItem(KEY_STORAGE, key);
    keyError?.classList.add("hidden");
    const ok = await load();
    if (ok) {
      gate?.classList.add("hidden");
      if (dash) dash.classList.remove("hidden");
    } else {
      sessionStorage.removeItem(KEY_STORAGE);
      keyError?.classList.remove("hidden");
    }
  });

  $("#refresh")?.addEventListener("click", () => void load());

  $("#funnel-window")?.addEventListener("click", (event) => {
    const btn = event.target.closest("button[data-window]");
    if (!btn || btn.dataset.window === funnelWindow) return;
    for (const b of document.querySelectorAll("#funnel-window button")) {
      b.classList.toggle("active", b === btn);
    }
    void loadFunnel(btn.dataset.window);
  });

  const storedKey = sessionStorage.getItem(KEY_STORAGE);
  if (storedKey) {
    gate?.classList.add("hidden");
    if (dash) dash.classList.remove("hidden");
    void load();
  } else {
    setStatus("Key required");
  }

  window.setInterval(() => {
    if (sessionStorage.getItem(KEY_STORAGE) && !dash?.classList.contains("hidden")) {
      void load();
    }
  }, 60_000);
</script>
</Plain>

