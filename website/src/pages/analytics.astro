---
import Plain from "../layouts/Plain.astro";
---

<Plain title="Resume Analytics">
  <main class="wrap">
    <header class="topbar">
      <div>
        <h1>Resume Analytics</h1>
        <p class="muted">cv.orozcoh.com — private dashboard</p>
      </div>
      <div class="actions">
        <span id="status" class="status"></span>
        <button id="refresh" type="button">Refresh</button>
      </div>
    </header>

    <section id="gate" class="gate">
      <form id="key-form">
        <label for="key-input">Analytics key</label>
        <div class="row">
          <input id="key-input" type="password" autocomplete="off" spellcheck="false" />
          <button type="submit">Unlock</button>
        </div>
        <p id="key-error" class="error hidden">Invalid key</p>
      </form>
    </section>

    <div id="dash" class="hidden">
      <section class="cards">
        <div class="card">
          <div class="num" id="s-downloads">–</div>
          <div class="label">Downloads</div>
          <div class="sub" id="s-downloads-sub"></div>
        </div>
        <div class="card">
          <div class="num" id="s-views">–</div>
          <div class="label">Resume views</div>
          <div class="sub" id="s-views-sub"></div>
        </div>
        <div class="card">
          <div class="num" id="s-opens">–</div>
          <div class="label">Resume opens</div>
          <div class="sub" id="s-opens-sub"></div>
        </div>
        <div class="card">
          <div class="num" id="s-pageviews">–</div>
          <div class="label">Page views</div>
          <div class="sub" id="s-pageviews-sub"></div>
        </div>
      </section>

      <section>
        <h2>Funnel</h2>
        <div class="funnel" id="funnel"></div>
      </section>

      <section class="two-col">
        <div>
          <h2>By resume</h2>
          <table class="table">
            <thead>
              <tr>
                <th>Resume</th>
                <th>Opens</th>
                <th>Views</th>
                <th>Downloads</th>
              </tr>
            </thead>
            <tbody id="t-resumes"></tbody>
          </table>
        </div>
        <div>
          <h2>By language</h2>
          <table class="table">
            <thead>
              <tr>
                <th>Language</th>
                <th>Views</th>
                <th>Downloads</th>
              </tr>
            </thead>
            <tbody id="t-languages"></tbody>
          </table>
        </div>
      </section>

      <section class="two-col">
        <div>
          <h2>Top countries</h2>
          <ol class="rank" id="t-countries"></ol>
        </div>
        <div>
          <h2>Top cities</h2>
          <ol class="rank" id="t-cities"></ol>
        </div>
      </section>

      <section>
        <h2>Recent activity</h2>
        <table class="table">
          <thead>
            <tr>
              <th>When</th>
              <th>Event</th>
              <th>Resume</th>
              <th>Format</th>
              <th>Location</th>
              <th>Version</th>
            </tr>
          </thead>
          <tbody id="t-live"></tbody>
        </table>
      </section>
    </div>
  </main>
</Plain>

<style>
  :root {
    color-scheme: dark;
  }
  .wrap {
    max-width: 56rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    color: #0a0a0a;
    line-height: 1.5;
  }
  .topbar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  h1 {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
  }
  .muted {
    color: #6b7280;
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .status {
    font-size: 0.75rem;
    color: #6b7280;
  }
  button {
    border: 1px solid #e5e7eb;
    background: #fff;
    border-radius: 0.5rem;
    padding: 0.375rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
  }
  button:hover {
    background: #f9fafb;
  }
  .gate {
    margin-top: 3rem;
    max-width: 24rem;
  }
  .gate label {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 0.375rem;
  }
  .row {
    display: flex;
    gap: 0.5rem;
  }
  input {
    flex: 1;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    padding: 0.4375rem 0.75rem;
    font-size: 0.875rem;
  }
  .error {
    color: #dc2626;
    font-size: 0.8125rem;
    margin: 0.5rem 0 0;
  }
  .hidden {
    display: none !important;
  }
  section {
    margin-top: 2.5rem;
  }
  h2 {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #6b7280;
    margin: 0 0 0.75rem;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.75rem;
  }
  .card {
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    padding: 1rem 1.125rem;
  }
  .num {
    font-size: 1.875rem;
    font-weight: 600;
    line-height: 1.1;
  }
  .label {
    font-size: 0.875rem;
    font-weight: 500;
    margin-top: 0.25rem;
  }
  .sub {
    font-size: 0.75rem;
    color: #6b7280;
    margin-top: 0.25rem;
  }
  .funnel {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .fstep {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .fstep .fname {
    width: 7rem;
    font-size: 0.875rem;
    color: #374151;
    flex-shrink: 0;
  }
  .fstep .fbar {
    flex: 1;
    height: 1.5rem;
    background: #f3f4f6;
    border-radius: 0.375rem;
    overflow: hidden;
    display: flex;
  }
  .fstep .fbar .fill {
    height: 100%;
    background: #2563eb;
    border-radius: 0.375rem;
    min-width: 2px;
  }
  .fstep .fcount {
    width: 4rem;
    text-align: right;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    color: #111827;
  }
  .fstep .fpct {
    width: 3.5rem;
    text-align: right;
    font-size: 0.75rem;
    color: #6b7280;
  }
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  @media (max-width: 48rem) {
    .two-col {
      grid-template-columns: 1fr;
    }
  }
  .table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .table th {
    text-align: left;
    font-weight: 500;
    color: #6b7280;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.375rem 0.5rem;
    border-bottom: 1px solid #e5e7eb;
  }
  .table td {
    padding: 0.4375rem 0.5rem;
    border-bottom: 1px solid #f3f4f6;
    font-variant-numeric: tabular-nums;
  }
  .table td.num {
    text-align: right;
    font-size: inherit;
  }
  .rank {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: rank;
  }
  .rank li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.375rem 0;
    border-bottom: 1px solid #f3f4f6;
    font-size: 0.875rem;
    counter-increment: rank;
  }
  .rank li::before {
    content: counter(rank);
    width: 1.25rem;
    color: #9ca3af;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  .rank .name {
    flex: 1;
  }
  .rank .count {
    color: #6b7280;
    font-variant-numeric: tabular-nums;
  }
  .live-event {
    font-variant-numeric: tabular-nums;
  }
</style>

<script>
  const KEY_STORAGE = "cv_analytics_key";
  const $ = <T extends HTMLElement>(id: string): T => document.getElementById(id) as T;

  const statusEl = $("#status");
  const dash = $("#dash");
  const gate = $("#gate");
  const keyInput = $("#key-input") as HTMLInputElement;
  const keyError = $("#key-error");

  function setStatus(text: string): void {
    statusEl.textContent = text;
  }

  async function api(path: string): Promise<unknown> {
    const key = sessionStorage.getItem(KEY_STORAGE);
    const res = await fetch(`/api/admin/analytics${path}`, {
      headers: key ? { "X-Analytics-Key": key } : {},
    });
    if (res.status === 401) throw new Error("unauthorized");
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    return res.json();
  }

  function fmt(n: number): string {
    return new Intl.NumberFormat("en-US", { notation: n >= 1000 ? "compact" : "standard" }).format(n);
  }

  function pct(part: number, whole: number): string {
    if (whole === 0) return "—";
    return `${Math.round((part / whole) * 100)}%`;
  }

  function cell(text: string | number, cls = ""): HTMLTableCellElement {
    const td = document.createElement("td");
    td.textContent = String(text);
    if (cls) td.className = cls;
    return td;
  }

  async function load(): Promise<boolean> {
    setStatus("Loading…");
    try {
      const [summary, funnel, resumes, languages, countries, cities, live] = (await Promise.all([
        api("/summary"),
        api("/funnel"),
        api("/resumes"),
        api("/languages"),
        api("/countries"),
        api("/cities"),
        api("/live"),
      ])) as Array<Record<string, unknown>>;

      const s = summary as {
        totals: Record<string, number>;
        today: Record<string, number>;
        week: Record<string, number>;
      };
      const d = s.totals.downloads ?? 0;
      const v = s.totals.views ?? 0;
      const o = s.totals.opens ?? 0;
      const pv = s.totals.pageViews ?? 0;

      $("#s-downloads").textContent = fmt(d);
      $("#s-downloads-sub").textContent = `${fmt(s.today.downloads ?? 0)} today · ${fmt(s.week.downloads ?? 0)} week`;
      $("#s-views").textContent = fmt(v);
      $("#s-views-sub").textContent = `${fmt(s.today.views ?? 0)} today · ${fmt(s.week.views ?? 0)} week`;
      $("#s-opens").textContent = fmt(o);
      $("#s-opens-sub").textContent = `${fmt(s.today.opens ?? 0)} today`;
      $("#s-pageviews").textContent = fmt(pv);
      $("#s-pageviews-sub").textContent = `${fmt(s.today.pageViews ?? 0)} today`;

      // Funnel: landing → open → view → download.
      const f = funnel as { opens: number; views: number; downloads: number };
      const funnelEl = $("#funnel");
      funnelEl.innerHTML = "";
      const steps = [
        { name: "Opens", value: f.opens ?? 0 },
        { name: "Views", value: f.views ?? 0 },
        { name: "Downloads", value: f.downloads ?? 0 },
      ];
      const max = Math.max(1, steps[0]?.value ?? 1);
      for (const step of steps) {
        const row = document.createElement("div");
        row.className = "fstep";
        const name = document.createElement("span");
        name.className = "fname";
        name.textContent = step.name;
        const bar = document.createElement("div");
        bar.className = "fbar";
        const fill = document.createElement("div");
        fill.className = "fill";
        fill.style.width = `${Math.max(2, (step.value / max) * 100)}%`;
        bar.appendChild(fill);
        const count = document.createElement("span");
        count.className = "fcount";
        count.textContent = fmt(step.value);
        const p = document.createElement("span");
        p.className = "fpct";
        p.textContent = step.name === "Opens" ? "100%" : pct(step.value, steps[0]?.value ?? 0);
        row.append(name, bar, count, p);
        funnelEl.appendChild(row);
      }

      const resumesBody = $("#t-resumes");
      resumesBody.innerHTML = "";
      for (const r of resumes as Array<Record<string, number | string>>) {
        const tr = document.createElement("tr");
        tr.append(cell(String(r.resume)), cell(fmt(Number(r.opens)), "num"), cell(fmt(Number(r.views)), "num"), cell(fmt(Number(r.downloads)), "num"));
        resumesBody.appendChild(tr);
      }

      const languagesBody = $("#t-languages");
      languagesBody.innerHTML = "";
      for (const l of languages as Array<Record<string, number | string>>) {
        const tr = document.createElement("tr");
        tr.append(cell(String(l.language)), cell(fmt(Number(l.views)), "num"), cell(fmt(Number(l.downloads)), "num"));
        languagesBody.appendChild(tr);
      }

      const countriesEl = $("#t-countries");
      countriesEl.innerHTML = "";
      for (const c of (countries as Array<Record<string, number | string>>).slice(0, 10)) {
        const li = document.createElement("li");
        const name = document.createElement("span");
        name.className = "name";
        name.textContent = String(c.name);
        const count = document.createElement("span");
        count.className = "count";
        count.textContent = `${fmt(Number(c.downloads))} downloads`;
        li.append(name, count);
        countriesEl.appendChild(li);
      }

      const citiesEl = $("#t-cities");
      citiesEl.innerHTML = "";
      for (const c of (cities as Array<Record<string, number | string>>).slice(0, 10)) {
        const li = document.createElement("li");
        const name = document.createElement("span");
        name.className = "name";
        name.textContent = String(c.name);
        const count = document.createElement("span");
        count.className = "count";
        count.textContent = `${fmt(Number(c.downloads))} downloads`;
        li.append(name, count);
        citiesEl.appendChild(li);
      }

      const liveBody = $("#t-live");
      liveBody.innerHTML = "";
      const time = new Intl.RelativeTimeFormat("en", { numeric: "auto" });
      for (const ev of live as Array<Record<string, string>>) {
        const tr = document.createElement("tr");
        const when = new Date(ev.timestamp);
        const ago = time.format(-Math.max(0, Math.round((Date.now() - when.getTime()) / 60000)), "minute");
        tr.className = "live-event";
        tr.append(
          cell(ago),
          cell(ev.event),
          cell(ev.resume || "—"),
          cell(ev.format || "—"),
          cell([ev.city, ev.country].filter(Boolean).join(", ") || "—"),
          cell(ev.version),
        );
        liveBody.appendChild(tr);
      }

      setStatus(`Updated ${new Date().toLocaleTimeString()}`);
      return true;
    } catch (error) {
      if (error instanceof Error && error.message === "unauthorized") {
        gate.classList.remove("hidden");
        dash.classList.add("hidden");
        setStatus("Key required");
      } else {
        setStatus(`Error: ${error instanceof Error ? error.message : "unknown"}`);
      }
      return false;
    }
  }

  $("#key-form").addEventListener("submit", async (event) => {
    event.preventDefault();
    const key = keyInput.value.trim();
    if (!key) return;
    sessionStorage.setItem(KEY_STORAGE, key);
    keyError.classList.add("hidden");
    const ok = await load();
    if (ok) {
      gate.classList.add("hidden");
    } else {
      sessionStorage.removeItem(KEY_STORAGE);
      keyError.classList.remove("hidden");
    }
  });

  $("#refresh").addEventListener("click", () => void load());

  const storedKey = sessionStorage.getItem(KEY_STORAGE);
  if (storedKey) {
    gate.classList.add("hidden");
    void load();
  } else {
    setStatus("Key required");
  }

  window.setInterval(() => {
    if (sessionStorage.getItem(KEY_STORAGE) && !dash.classList.contains("hidden")) {
      void load();
    }
  }, 60_000);
</script>
