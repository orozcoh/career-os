---
import Plain from "../layouts/Plain.astro";
---

<Plain title="Resume Analytics">
  <main class="wrap">
    <header class="topbar">
      <div>
        <h1>Resume Analytics</h1>
        <p class="muted">cv.orozcoh.com — private dashboard</p>
      </div>
      <div class="actions">
        <span id="status" class="status"></span>
        <button id="refresh" type="button">Refresh</button>
      </div>
    </header>

    <section id="gate" class="gate">
      <form id="key-form">
        <label for="key-input">Analytics key</label>
        <div class="row">
          <input id="key-input" type="password" autocomplete="off" spellcheck="false" />
          <button type="submit">Unlock</button>
        </div>
        <p id="key-error" class="error hidden">Invalid key</p>
      </form>
    </section>

    <div id="dash" class="hidden">
      <section class="cards">
        <div class="card">
          <div class="num" id="s-downloads">–</div>
          <div class="label">Downloads</div>
          <div class="sub" id="s-downloads-sub"></div>
        </div>
        <div class="card">
          <div class="num" id="s-views">–</div>
          <div class="label">Resume views</div>
          <div class="sub" id="s-views-sub"></div>
        </div>
        <div class="card">
          <div class="num" id="s-opens">–</div>
          <div class="label">Resume opens</div>
          <div class="sub" id="s-opens-sub"></div>
        </div>
        <div class="card">
          <div class="num" id="s-pageviews">–</div>
          <div class="label">Page views</div>
          <div class="sub" id="s-pageviews-sub"></div>
        </div>
      </section>

      <section>
        <h2>Funnel</h2>
        <div class="funnel" id="funnel"></div>
      </section>

      <section class="two-col">
        <div>
          <h2>By resume</h2>
          <table class="table">
            <thead>
              <tr>
                <th>Resume</th>
                <th>Opens</th>
                <th>Views</th>
                <th>Downloads</th>
              </tr>
            </thead>
            <tbody id="t-resumes"></tbody>
          </table>
        </div>
        <div>
          <h2>By language</h2>
          <table class="table">
            <thead>
              <tr>
                <th>Language</th>
                <th>Views</th>
                <th>Downloads</th>
              </tr>
            </thead>
            <tbody id="t-languages"></tbody>
          </table>
        </div>
      </section>

      <section class="two-col">
        <div>
          <h2>Top countries</h2>
          <ol class="rank" id="t-countries"></ol>
        </div>
        <div>
          <h2>Top cities</h2>
          <ol class="rank" id="t-cities"></ol>
        </div>
      </section>

      <section>
        <h2>Recent activity</h2>
        <table class="table">
          <thead>
            <tr>
              <th>When</th>
              <th>Event</th>
              <th>Resume</th>
              <th>Format</th>
              <th>Location</th>
              <th>Version</th>
            </tr>
          </thead>
          <tbody id="t-live"></tbody>
        </table>
      </section>
    </div>
  </main>

<script is:inline>
  const KEY_STORAGE = "cv_analytics_key";
  const $ = (id) => document.getElementById(id.replace(/^#/, ""));

  const statusEl = $("#status");
  const dash = $("#dash");
  const gate = $("#gate");
  const keyInput = $("#key-input");
  const keyError = $("#key-error");

  function setStatus(text) {
    if (statusEl) statusEl.textContent = text;
  }

  async function api(path) {
    const key = sessionStorage.getItem(KEY_STORAGE);
    const res = await fetch(`/api/admin/analytics${path}`, {
      headers: key ? { "X-Analytics-Key": key } : {},
    });
    if (res.status === 401) throw new Error("unauthorized");
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    return res.json();
  }

  function fmt(n) {
    return new Intl.NumberFormat("en-US", { notation: n >= 1000 ? "compact" : "standard" }).format(n);
  }

  function pct(part, whole) {
    if (whole === 0) return "—";
    return `${Math.round((part / whole) * 100)}%`;
  }

  function cell(text, cls = "") {
    const td = document.createElement("td");
    td.textContent = String(text);
    if (cls) td.className = cls;
    return td;
  }

  async function load() {
    setStatus("Loading…");
    try {
      const results = await Promise.all([
        api("/summary"),
        api("/funnel"),
        api("/resumes"),
        api("/languages"),
        api("/countries"),
        api("/cities"),
        api("/live"),
      ]);

      const summary = results[0] ?? {};
      const funnel = results[1] ?? {};
      const resumes = results[2] ?? [];
      const languages = results[3] ?? [];
      const countries = results[4] ?? [];
      const cities = results[5] ?? [];
      const live = results[6] ?? [];

      const totals = summary.totals ?? {};
      const today = summary.today ?? {};
      const week = summary.week ?? {};
      const d = totals.downloads ?? 0;
      const v = totals.views ?? 0;
      const o = totals.opens ?? 0;
      const pv = totals.pageViews ?? 0;

      setText("#s-downloads", fmt(d));
      setText("#s-downloads-sub", `${fmt(today.downloads ?? 0)} today · ${fmt(week.downloads ?? 0)} week`);
      setText("#s-views", fmt(v));
      setText("#s-views-sub", `${fmt(today.views ?? 0)} today · ${fmt(week.views ?? 0)} week`);
      setText("#s-opens", fmt(o));
      setText("#s-opens-sub", `${fmt(today.opens ?? 0)} today`);
      setText("#s-pageviews", fmt(pv));
      setText("#s-pageviews-sub", `${fmt(today.pageViews ?? 0)} today`);

      // Funnel: landing → open → view → download.
      const funnelEl = $("#funnel");
      if (funnelEl) {
        funnelEl.innerHTML = "";
        const steps = [
          { name: "Opens", value: funnel.opens ?? 0 },
          { name: "Views", value: funnel.views ?? 0 },
          { name: "Downloads", value: funnel.downloads ?? 0 },
        ];
        const max = Math.max(1, steps[0]?.value ?? 1);
        for (const step of steps) {
          const row = document.createElement("div");
          row.className = "fstep";
          const name = document.createElement("span");
          name.className = "fname";
          name.textContent = step.name;
          const bar = document.createElement("div");
          bar.className = "fbar";
          const fill = document.createElement("div");
          fill.className = "fill";
          fill.style.width = `${Math.max(2, (step.value / max) * 100)}%`;
          bar.appendChild(fill);
          const count = document.createElement("span");
          count.className = "fcount";
          count.textContent = fmt(step.value);
          const p = document.createElement("span");
          p.className = "fpct";
          p.textContent = step.name === "Opens" ? "100%" : pct(step.value, steps[0]?.value ?? 0);
          row.append(name, bar, count, p);
          funnelEl.appendChild(row);
        }
      }

      const resumesBody = $("#t-resumes");
      if (resumesBody) {
        resumesBody.innerHTML = "";
        for (const r of resumes) {
          const tr = document.createElement("tr");
          tr.append(
            cell(String(r.resume)),
            cell(fmt(Number(r.opens ?? 0)), "num"),
            cell(fmt(Number(r.views ?? 0)), "num"),
            cell(fmt(Number(r.downloads ?? 0)), "num"),
          );
          resumesBody.appendChild(tr);
        }
      }

      const languagesBody = $("#t-languages");
      if (languagesBody) {
        languagesBody.innerHTML = "";
        for (const l of languages) {
          const tr = document.createElement("tr");
          tr.append(
            cell(String(l.language)),
            cell(fmt(Number(l.views ?? 0)), "num"),
            cell(fmt(Number(l.downloads ?? 0)), "num"),
          );
          languagesBody.appendChild(tr);
        }
      }

      const countriesEl = $("#t-countries");
      if (countriesEl) {
        countriesEl.innerHTML = "";
        for (const c of countries.slice(0, 10)) {
          const li = document.createElement("li");
          const name = document.createElement("span");
          name.className = "name";
          name.textContent = String(c.name);
          const count = document.createElement("span");
          count.className = "count";
          count.textContent = `${fmt(Number(c.downloads ?? 0))} downloads`;
          li.append(name, count);
          countriesEl.appendChild(li);
        }
      }

      const citiesEl = $("#t-cities");
      if (citiesEl) {
        citiesEl.innerHTML = "";
        for (const c of cities.slice(0, 10)) {
          const li = document.createElement("li");
          const name = document.createElement("span");
          name.className = "name";
          name.textContent = String(c.name);
          const count = document.createElement("span");
          count.className = "count";
          count.textContent = `${fmt(Number(c.downloads ?? 0))} downloads`;
          li.append(name, count);
          citiesEl.appendChild(li);
        }
      }

      const liveBody = $("#t-live");
      if (liveBody) {
        liveBody.innerHTML = "";
        const time = new Intl.RelativeTimeFormat("en", { numeric: "auto" });
        for (const ev of live) {
          const tr = document.createElement("tr");
          const when = new Date(ev.timestamp);
          const ago = time.format(-Math.max(0, Math.round((Date.now() - when.getTime()) / 60000)), "minute");
          tr.className = "live-event";
          tr.append(
            cell(ago),
            cell(ev.event),
            cell(ev.resume || "—"),
            cell(ev.format || "—"),
            cell([ev.city, ev.country].filter(Boolean).join(", ") || "—"),
            cell(ev.version),
          );
          liveBody.appendChild(tr);
        }
      }

      setStatus(`Updated ${new Date().toLocaleTimeString()}`);
      return true;
    } catch (error) {
      if (error instanceof Error && error.message === "unauthorized") {
        if (gate) gate.classList.remove("hidden");
        if (dash) dash.classList.add("hidden");
        setStatus("Key required");
      } else {
        setStatus(`Error: ${error instanceof Error ? error.message : "unknown"}`);
      }
      return false;
    }
  }

  function setText(id, text) {
    const el = $(id);
    if (el) el.textContent = text;
  }

  const keyForm = $("#key-form");
  keyForm?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const key = keyInput?.value.trim() ?? "";
    if (!key) return;
    sessionStorage.setItem(KEY_STORAGE, key);
    keyError?.classList.add("hidden");
    const ok = await load();
    if (ok) {
      gate?.classList.add("hidden");
      if (dash) dash.classList.remove("hidden");
    } else {
      sessionStorage.removeItem(KEY_STORAGE);
      keyError?.classList.remove("hidden");
    }
  });

  $("#refresh")?.addEventListener("click", () => void load());

  const storedKey = sessionStorage.getItem(KEY_STORAGE);
  if (storedKey) {
    gate?.classList.add("hidden");
    if (dash) dash.classList.remove("hidden");
    void load();
  } else {
    setStatus("Key required");
  }

  window.setInterval(() => {
    if (sessionStorage.getItem(KEY_STORAGE) && !dash?.classList.contains("hidden")) {
      void load();
    }
  }, 60_000);
</script>
</Plain>

<style>
  :root {
    color-scheme: dark;
  }
  .wrap {
    max-width: 56rem;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 5rem;
    font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    color: #0a0a0a;
    line-height: 1.5;
  }
  .topbar {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }
  h1 {
    font-size: 1.5rem;
    font-weight: 600;
    margin: 0;
  }
  .muted {
    color: #6b7280;
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .status {
    font-size: 0.75rem;
    color: #6b7280;
  }
  button {
    border: 1px solid #e5e7eb;
    background: #fff;
    border-radius: 0.5rem;
    padding: 0.375rem 0.875rem;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
  }
  button:hover {
    background: #f9fafb;
  }
  .gate {
    margin-top: 3rem;
    max-width: 24rem;
  }
  .gate label {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 0.375rem;
  }
  .row {
    display: flex;
    gap: 0.5rem;
  }
  input {
    flex: 1;
    border: 1px solid #d1d5db;
    border-radius: 0.5rem;
    padding: 0.4375rem 0.75rem;
    font-size: 0.875rem;
  }
  .error {
    color: #dc2626;
    font-size: 0.8125rem;
    margin: 0.5rem 0 0;
  }
  .hidden {
    display: none !important;
  }
  section {
    margin-top: 2.5rem;
  }
  h2 {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #6b7280;
    margin: 0 0 0.75rem;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 0.75rem;
  }
  .card {
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    padding: 1rem 1.125rem;
  }
  .num {
    font-size: 1.875rem;
    font-weight: 600;
    line-height: 1.1;
  }
  .label {
    font-size: 0.875rem;
    font-weight: 500;
    margin-top: 0.25rem;
  }
  .sub {
    font-size: 0.75rem;
    color: #6b7280;
    margin-top: 0.25rem;
  }
  .funnel {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .fstep {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .fstep .fname {
    width: 7rem;
    font-size: 0.875rem;
    color: #374151;
    flex-shrink: 0;
  }
  .fstep .fbar {
    flex: 1;
    height: 1.5rem;
    background: #f3f4f6;
    border-radius: 0.375rem;
    overflow: hidden;
    display: flex;
  }
  .fstep .fbar .fill {
    height: 100%;
    background: #2563eb;
    border-radius: 0.375rem;
    min-width: 2px;
  }
  .fstep .fcount {
    width: 4rem;
    text-align: right;
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    color: #111827;
  }
  .fstep .fpct {
    width: 3.5rem;
    text-align: right;
    font-size: 0.75rem;
    color: #6b7280;
  }
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  @media (max-width: 48rem) {
    .two-col {
      grid-template-columns: 1fr;
    }
  }
  .table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .table th {
    text-align: left;
    font-weight: 500;
    color: #6b7280;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.375rem 0.5rem;
    border-bottom: 1px solid #e5e7eb;
  }
  .table td {
    padding: 0.4375rem 0.5rem;
    border-bottom: 1px solid #f3f4f6;
    font-variant-numeric: tabular-nums;
  }
  .table td.num {
    text-align: right;
    font-size: inherit;
  }
  .rank {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: rank;
  }
  .rank li {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    padding: 0.375rem 0;
    border-bottom: 1px solid #f3f4f6;
    font-size: 0.875rem;
    counter-increment: rank;
  }
  .rank li::before {
    content: counter(rank);
    width: 1.25rem;
    color: #9ca3af;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  .rank .name {
    flex: 1;
  }
  .rank .count {
    color: #6b7280;
    font-variant-numeric: tabular-nums;
  }
  .live-event {
    font-variant-numeric: tabular-nums;
  }
</style>


