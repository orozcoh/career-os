---
import Base from "../../layouts/Base.astro";
import LanguageToggle from "../../components/LanguageToggle.astro";
import { getResumes, getLocaleFile } from "../../lib/data";
import { RELEASE_VERSION } from "../../lib/version";
import type { Locale } from "@career/core";
import { t, SUPPORTED_LOCALES } from "@career/core";

export async function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const resumes = await getResumes();
const profile = resumes[0]?.profile;
const localeFile = await getLocaleFile(locale);

const title = profile ? `${profile.name} — ${localeFile.website.title_suffix}` : localeFile.website.title_suffix;
const description = profile?.summary_short 
  ? t(profile.summary_short, locale)
  : localeFile.website.meta_fallback;
---

<Base title={title} description={description} locale={locale}>
  <main class="mx-auto max-w-3xl px-6 py-16 sm:py-24">
    <header class="flex items-start justify-between gap-6">
      <div>
        <h1 class="text-4xl font-semibold tracking-tight">{profile?.name}</h1>
        <p class="mt-2 text-lg text-muted">{profile ? t(profile.title, locale) : ""}</p>
        <p class="mt-6 max-w-xl leading-7 text-muted">
          {localeFile.website.hero}
        </p>
      </div>
      <LanguageToggle locale={locale} />
    </header>

    <div class="mt-14 grid gap-5 sm:grid-cols-2">
      {
        resumes.map((resume) => (
          <section class="flex flex-col rounded-xl border border-line p-6 transition-colors hover:border-faint">
            <h2 class="text-lg font-semibold">{t(resume.template.name, locale)}</h2>
            <p class="mt-2 flex-1 text-sm leading-6 text-muted">{t(resume.template.description, locale)}</p>
            <div class="mt-6 flex items-center gap-5 text-sm font-medium">
              <a href={`/${locale}/${resume.template.slug}`} class="text-accent hover:text-accent-hover">
                {localeFile.website.view_online} →
              </a>
              <a
                href={`/${locale}/resumes/${resume.template.slug}.pdf`}
                download
                class="text-accent hover:text-accent-hover"
              >
                {localeFile.website.download_pdf}
              </a>
            </div>
          </section>
        ))
      }
    </div>

    <footer class="mt-20 border-t border-line pt-6 text-sm text-faint">
      <p>
        {localeFile.website.generated_from} · {localeFile.website.version}{RELEASE_VERSION}
        {
          profile && (
            <>
              {" · "}
              <a href={profile.github} class="hover:text-muted">
                GitHub
              </a>
              {" · "}
              <a href={profile.linkedin} class="hover:text-muted">
                LinkedIn
              </a>
            </>
          )
        }
      </p>
    </footer>
  </main>
</Base>
